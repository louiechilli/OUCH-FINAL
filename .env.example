POSTGRES_USER=epos
POSTGRES_PASSWORD=epos
POSTGRES_DB=epos
DATABASE_URL=postgresql://epos:epos@db:5432/epos
PORT=4000

JWT_SECRET=change-me-to-a-long-random-string

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Staff EPOS app — block use until push notifications are enabled (true/false)
VITE_NOTIFICATIONS_REQUIRED=true

# Required for Google Calendar sync — see GOOGLE_CALENDAR.md.
# Also used for client portal links in SMS if PORTAL_BASE_URL is not set.
PUBLIC_BASE_URL=
PORTAL_BASE_URL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# SumUp Solo Cloud API — see https://developer.sumup.com/terminal-payments/cloud-api/
TERMINAL_PROVIDER=sumup
SUMUP_API_KEY=
SUMUP_MERCHANT_CODE=
SUMUP_AFFILIATE_APP_ID=
SUMUP_AFFILIATE_KEY=
SUMUP_CURRENCY=GBP

# Redis job queue (SMS and future async work)
REDIS_URL=redis://redis:6379

# SMS gateway (smsgate HTTP driver — replace with a provider later)
SMS_PROVIDER=smsgate
SMSGATE_URL=http://192.168.50.118:8080/message
SMSGATE_USERNAME=sms
SMSGATE_PASSWORD=
